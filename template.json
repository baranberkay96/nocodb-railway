{
  "name": "NocoDB 2026.10 Airtable Alternative (Postgres, Redis, Worker, S3)",
  "idSeed": "NocoDB 2026.10 Airtable Alternative (Postgres, Redis, Worker, S3)",
  "description": "Spreadsheet UI on Postgres with a job worker, Redis and Bucket uploads.",
  "category": "Other",
  "tags": [
    "nocodb",
    "airtable-alternative",
    "no-code",
    "database",
    "spreadsheet",
    "postgres",
    "redis",
    "self-hosted"
  ],
  "image": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/nocodb.svg",
  "upstream": {
    "repo": "nocodb/nocodb",
    "version": "2026.10.2",
    "license": "Sustainable Use License 1.0 (since 2026-01-29)",
    "images": {
      "nocodb": "nocodb/nocodb:2026.10.2@sha256:c8fd5e028cfd3932fefaae775ea25bf1949ea64b8a042e6582892a14bc216fa9 (released 2026-11-19)",
      "postgres": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863",
      "redis": "redis:8.2.11@sha256:b0b01167ff47bc3868e56a967895a26be4230891a1f42a78ab61cdd227accc8d"
    },
    "checked": "2026-11-24"
  },
  "services": {
    "NocoDB": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/nocodb.svg",
      "source": {
        "repo": "baranberkay96/nocodb-railway",
        "rootDirectory": "/services/nocodb"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/api/v1/health",
      "healthcheckTimeout": 900,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/usr/app/data"
      },
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port NocoDB listens on.",
          "required": false
        },
        "NC_DB": {
          "defaultValue": "pg://${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432?u=${{Postgres.POSTGRES_USER}}&p=${{Postgres.POSTGRES_PASSWORD}}&d=${{Postgres.POSTGRES_DB}}",
          "description": "NocoDB metadata database (private network).",
          "required": false
        },
        "NC_REDIS_URL": {
          "defaultValue": "${{Redis.REDIS_URL}}",
          "description": "Redis for cache and the job queue shared with the worker.",
          "required": false
        },
        "NC_AUTH_JWT_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs login tokens. Changing it logs everyone out.",
          "required": false
        },
        "NC_PUBLIC_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL used in links and e-mails. Change it when you add a custom domain.",
          "required": false
        },
        "NC_ADMIN_EMAIL": {
          "defaultValue": "",
          "description": "Super admin e-mail, created on the first start.",
          "required": true
        },
        "NC_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Super admin password (8+ characters). NocoDB re-applies it on every start.",
          "required": false
        },
        "NC_S3_BUCKET_NAME": {
          "defaultValue": "${{Bucket.BUCKET}}",
          "description": "Railway Bucket for attachments.",
          "required": false
        },
        "NC_S3_REGION": {
          "defaultValue": "${{Bucket.REGION}}",
          "description": "Bucket region.",
          "required": false
        },
        "NC_S3_ENDPOINT": {
          "defaultValue": "${{Bucket.ENDPOINT}}",
          "description": "Bucket endpoint.",
          "required": false
        },
        "NC_S3_ACCESS_KEY": {
          "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
          "description": "Bucket access key.",
          "required": false
        },
        "NC_S3_ACCESS_SECRET": {
          "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
          "description": "Bucket secret key.",
          "required": false
        },
        "NC_S3_FORCE_PATH_STYLE": {
          "defaultValue": "false",
          "description": "Railway Buckets use virtual-hosted-style URLs.",
          "required": false
        },
        "NC_SECURE_ATTACHMENTS": {
          "defaultValue": "true",
          "description": "Serve attachments through signed URLs (the Bucket is private).",
          "required": false
        },
        "NC_DISABLE_TELE": {
          "defaultValue": "true",
          "description": "Turn off anonymous usage telemetry.",
          "required": false
        },
        "NC_INVITE_ONLY_SIGNUP": {
          "defaultValue": "true",
          "description": "true: the start script turns on invite-only sign-up. false: manage it in Account settings.",
          "required": false
        },
        "NC_SMTP_FROM": {
          "defaultValue": "",
          "description": "Optional sender address (SMTP needs Railway Pro; NocoDB's App Store also has HTTP e-mail plugins).",
          "required": false
        },
        "NC_SMTP_HOST": {
          "defaultValue": "",
          "description": "Optional SMTP host.",
          "required": false
        },
        "NC_SMTP_PORT": {
          "defaultValue": "",
          "description": "Optional SMTP port.",
          "required": false
        },
        "NC_SMTP_USERNAME": {
          "defaultValue": "",
          "description": "Optional SMTP user name.",
          "required": false
        },
        "NC_SMTP_PASSWORD": {
          "defaultValue": "",
          "description": "Optional SMTP password.",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "30",
          "description": "Grace period for in-flight requests on redeploy.",
          "required": false
        }
      }
    },
    "NocoDB Worker": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/nocodb.svg",
      "source": {
        "repo": "baranberkay96/nocodb-railway",
        "rootDirectory": "/services/nocodb"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port of the worker's internal API (healthcheck).",
          "required": false
        },
        "NC_WORKER_CONTAINER": {
          "defaultValue": "true",
          "description": "Run as the background job worker.",
          "required": false
        },
        "NC_DB": {
          "defaultValue": "${{NocoDB.NC_DB}}",
          "description": "NocoDB metadata database (private network).",
          "required": false
        },
        "NC_REDIS_URL": {
          "defaultValue": "${{NocoDB.NC_REDIS_URL}}",
          "description": "Redis for cache and the job queue shared with the worker.",
          "required": false
        },
        "NC_AUTH_JWT_SECRET": {
          "defaultValue": "${{NocoDB.NC_AUTH_JWT_SECRET}}",
          "description": "Signs login tokens. Changing it logs everyone out.",
          "required": false
        },
        "NC_PUBLIC_URL": {
          "defaultValue": "${{NocoDB.NC_PUBLIC_URL}}",
          "description": "Public URL used in links and e-mails. Change it when you add a custom domain.",
          "required": false
        },
        "NC_ADMIN_EMAIL": {
          "defaultValue": "${{NocoDB.NC_ADMIN_EMAIL}}",
          "description": "Super admin e-mail, created on the first start.",
          "required": false
        },
        "NC_ADMIN_PASSWORD": {
          "defaultValue": "${{NocoDB.NC_ADMIN_PASSWORD}}",
          "description": "Super admin password (8+ characters). NocoDB re-applies it on every start.",
          "required": false
        },
        "NC_S3_BUCKET_NAME": {
          "defaultValue": "${{NocoDB.NC_S3_BUCKET_NAME}}",
          "description": "Railway Bucket for attachments.",
          "required": false
        },
        "NC_S3_REGION": {
          "defaultValue": "${{NocoDB.NC_S3_REGION}}",
          "description": "Bucket region.",
          "required": false
        },
        "NC_S3_ENDPOINT": {
          "defaultValue": "${{NocoDB.NC_S3_ENDPOINT}}",
          "description": "Bucket endpoint.",
          "required": false
        },
        "NC_S3_ACCESS_KEY": {
          "defaultValue": "${{NocoDB.NC_S3_ACCESS_KEY}}",
          "description": "Bucket access key.",
          "required": false
        },
        "NC_S3_ACCESS_SECRET": {
          "defaultValue": "${{NocoDB.NC_S3_ACCESS_SECRET}}",
          "description": "Bucket secret key.",
          "required": false
        },
        "NC_S3_FORCE_PATH_STYLE": {
          "defaultValue": "${{NocoDB.NC_S3_FORCE_PATH_STYLE}}",
          "description": "Railway Buckets use virtual-hosted-style URLs.",
          "required": false
        },
        "NC_SECURE_ATTACHMENTS": {
          "defaultValue": "${{NocoDB.NC_SECURE_ATTACHMENTS}}",
          "description": "Serve attachments through signed URLs (the Bucket is private).",
          "required": false
        },
        "NC_DISABLE_TELE": {
          "defaultValue": "${{NocoDB.NC_DISABLE_TELE}}",
          "description": "Turn off anonymous usage telemetry.",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "120",
          "description": "Lets running jobs finish on redeploy.",
          "required": false
        }
      }
    },
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": false
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": false
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": false
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": false
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "Private connection URL used by Baserow.",
          "required": false
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": false
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": false
        }
      }
    },
    "Redis": {
      "icon": "https://cdn.sanity.io/images/sy1jschh/production/0ce0bfdcfbdbf69662b1116671f97c2dd788b655-157x157.svg",
      "source": {
        "image": "redis:8.2.11@sha256:b0b01167ff47bc3868e56a967895a26be4230891a1f42a78ab61cdd227accc8d"
      },
      "startCommand": "/bin/sh -c \"rm -rf $RAILWAY_VOLUME_MOUNT_PATH/lost+found/ && exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --save 60 1 --dir $RAILWAY_VOLUME_MOUNT_PATH\"",
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/data"
      },
      "variables": {
        "REDISHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private network hostname of the Redis service.",
          "required": false
        },
        "REDISPORT": {
          "defaultValue": "6379",
          "description": "Port that Redis listens on.",
          "required": false
        },
        "REDISUSER": {
          "defaultValue": "default",
          "description": "Username for authenticating with Redis.",
          "required": false
        },
        "REDIS_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Randomly generated password for authenticating with Redis.",
          "required": false
        },
        "REDISPASSWORD": {
          "defaultValue": "${{REDIS_PASSWORD}}",
          "description": "Alias of REDIS_PASSWORD.",
          "required": false
        },
        "REDIS_URL": {
          "defaultValue": "redis://${{ REDISUSER }}:${{ REDIS_PASSWORD }}@${{ REDISHOST }}:${{ REDISPORT }}",
          "description": "Private connection URL used by Baserow (cache, websockets, Celery broker).",
          "required": false
        }
      }
    }
  },
  "buckets": [
    "Bucket"
  ]
}